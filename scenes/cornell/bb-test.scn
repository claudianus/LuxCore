# temperature field: firedata [0..0.764] -> [0..~9170] K
scene.textures.tempk.type = scale
scene.textures.tempk.texture1 = firedata
scene.textures.tempk.texture2 = 12000

# per-point Planckian color at the grid temperature
scene.textures.bb.type = blackbody
scene.textures.bb.temperature = tempk
scene.textures.bb.normalize = 1

# emission = blackbody chromaticity x density mask (zero outside the blob)
scene.textures.mask.type = scale
scene.textures.mask.texture1 = firedata
scene.textures.mask.texture2 = 40
scene.textures.fireemis.type = scale
scene.textures.fireemis.texture1 = bb
scene.textures.fireemis.texture2 = mask
