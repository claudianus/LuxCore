scene.textures.strandu_x3.type = scale
scene.textures.strandu_x3.texture1 = strandu
scene.textures.strandu_x3.texture2 = 3.0
scene.textures.strandgrad.type = band
scene.textures.strandgrad.amount = strandu
scene.textures.strandgrad.interpolation = none
scene.textures.strandgrad.offset0 = 0.0
scene.textures.strandgrad.value0 = 1.0 0.0 0.0
scene.textures.strandgrad.offset1 = 0.5
scene.textures.strandgrad.value1 = 0.0 0.0 1.0
##
scene.materials.hair_mat.type = matte
